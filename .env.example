# Public site origin used for canonical URLs, Open Graph, sitemap, and robots.
NEXT_PUBLIC_SITE_URL=https://www.lifesutra.co.in

# Turso (libSQL) is the system of record for accounts, roles, sessions and audit events.
# Create a token with `turso db tokens create <db>`. For a local file use DATABASE_URL="file:./dev.db".
DATABASE_URL="libsql://<db>-<org>.turso.io"
TURSO_AUTH_TOKEN=""

# Number of trusted reverse proxies in front of the app (Vercel/nginx/Cloudflare = 1).
# The client IP (used for rate limiting and the audit log) is taken that many hops from the
# RIGHT of X-Forwarded-For, so a client cannot spoof it. 0 = ignore the header entirely.
TRUSTED_PROXY_COUNT=1

# Password-reset mail transport: "console" prints the reset link to the server log
# (development only), "none" drops mail (production default until a provider is wired in
# src/lib/mail.ts).
# MAIL_TRANSPORT=console

# Integration tests run against a separate database whose name must end in _test.
# Defaults to "<DATABASE_URL database>_test" on the same server.
# TEST_DATABASE_URL="postgresql://life_sutra:change-me@localhost:5432/life_sutra_test?schema=public"
