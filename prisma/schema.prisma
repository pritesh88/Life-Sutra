generator client {
  provider = "prisma-client-js"
}

// Runtime traffic goes to Turso (libSQL) through @prisma/adapter-libsql, see
// src/lib/prisma-client.ts. The Prisma CLI cannot talk to libsql:// URLs, so this
// URL is only a local SQLite file used for generating migrations; they are
// applied to Turso with `npm run db:deploy` (prisma/migrate-turso.ts).
datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ---------------------------------------------------------------------------
// Identity, roles and permissions
// User -> UserRole -> Role -> RolePermission -> Permission
// The role -> permission mapping is defined in src/lib/auth/rbac/catalog.ts and
// mirrored into these tables by `npm run db:seed` (idempotent sync).
// ---------------------------------------------------------------------------

model User {
  id                String               @id @default(cuid())
  email             String               @unique
  name              String
  passwordHash      String
  isActive          Boolean              @default(true)
  passwordChangedAt DateTime             @default(now())
  lastLoginAt       DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  roles             UserRole[]
  sessions          Session[]
  resetTokens       PasswordResetToken[]
  auditEvents       AuditLog[]           @relation("AuditActor")
  articles          Article[]            @relation("ArticleAuthor")
  reviewAssignments ReviewAssignment[]   @relation("ReviewAssignmentReviewer")
  assignmentsMade   ReviewAssignment[]   @relation("ReviewAssignmentAssigner")
}

model Role {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  description String?
  createdAt   DateTime         @default(now())
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(cuid())
  resource    String
  action      String
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]

  @@unique([resource, action])
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  assignedBy String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  grantedAt    DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

// ---------------------------------------------------------------------------
// Sessions (opaque, server-side). Only SHA-256 hashes of tokens are stored.
//  - expiresAt        absolute lifetime cap
//  - lastSeenAt       drives the idle timeout
//  - rotatedAt        last token rotation; the previous token stays valid for a
//                     short grace window so concurrent tabs do not race
//  - revokedAt        logout / admin revoke / password change / deactivation
// ---------------------------------------------------------------------------

model Session {
  id                 String    @id @default(cuid())
  tokenHash          String    @unique
  previousTokenHash  String?   @unique
  previousValidUntil DateTime?
  csrfTokenHash      String
  userId             String
  expiresAt          DateTime
  createdAt          DateTime  @default(now())
  lastSeenAt         DateTime  @default(now())
  rotatedAt          DateTime  @default(now())
  revokedAt          DateTime?
  revokedReason      String?
  userAgent          String?
  ipAddress          String?
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  ipAddress String?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Fixed-window counters used for brute-force / abuse protection. Kept in
// PostgreSQL so limits hold across server instances without extra infrastructure.
model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime
  expiresAt   DateTime

  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Audit trail. Append-only: a database trigger rejects UPDATE, DELETE and
// TRUNCATE (see the 20260920090000 migration). Users are deactivated, never
// deleted, so the actor FK is RESTRICT.
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  event      String
  resource   String?
  action     String?
  targetType String?
  targetId   String?
  outcome    String   @default("SUCCESS")
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId, createdAt])
  @@index([event, createdAt])
  @@index([targetType, targetId])
}

// ---------------------------------------------------------------------------
// Peer review (double-anonymous)
// Identity-bearing columns: Article.authorId, ReviewAssignment.reviewerId,
// ReviewAssignment.assignedById. They must only be selected by code paths that
// are explicitly allowed to see them; every API response is built through the
// whitelisted views in src/lib/peer-review/views.ts.
// ---------------------------------------------------------------------------

enum ArticleStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  REVISION_REQUESTED
  ACCEPTED
  REJECTED
  PUBLISHED
}

enum ReviewAssignmentStatus {
  PENDING
  SUBMITTED
}

enum ReviewRecommendation {
  ACCEPT
  MINOR_REVISION
  MAJOR_REVISION
  REJECT
}

model Article {
  id                 String             @id @default(cuid())
  authorId           String
  title              String
  abstract           String
  manuscriptFileName String?
  status             ArticleStatus      @default(DRAFT)
  submittedAt        DateTime?
  decidedAt          DateTime?
  decisionNote       String?
  publishedAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  author             User               @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  assignments        ReviewAssignment[]

  @@index([authorId])
  @@index([status])
}

model ReviewAssignment {
  id             String                 @id @default(cuid())
  articleId      String
  reviewerId     String
  assignedById   String
  // Per-article ordinal shown to the author ("Reviewer 2"); never the identity.
  reviewerLabel  Int
  status         ReviewAssignmentStatus @default(PENDING)
  createdAt      DateTime               @default(now())
  article        Article                @relation(fields: [articleId], references: [id], onDelete: Cascade)
  reviewer       User                   @relation("ReviewAssignmentReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  assignedBy     User                   @relation("ReviewAssignmentAssigner", fields: [assignedById], references: [id], onDelete: Restrict)
  review         Review?

  @@unique([articleId, reviewerId])
  @@unique([articleId, reviewerLabel])
  @@index([reviewerId])
}

model Review {
  id               String               @id @default(cuid())
  assignmentId     String               @unique
  recommendation   ReviewRecommendation
  commentsToAuthor String
  commentsToEditor String?
  submittedAt      DateTime             @default(now())
  assignment       ReviewAssignment     @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
}
